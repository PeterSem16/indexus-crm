diff --git a/server/lib/ai-jobs/email-regeneration.ts b/server/lib/ai-jobs/email-regeneration.ts
new file mode 100644
--- /dev/null
+++ b/server/lib/ai-jobs/email-regeneration.ts
@@ -0,0 +1,42 @@
+import { randomUUID } from "node:crypto";
+import { JobError } from "./policy";
+import { fingerprint, jobTransaction, type JobPool, type JobRow, type JobSQL } from "./store";
+
+/** One immutable child per completed source. Replaying the request never starts a second child. */
+export async function emailRegeneration(
+  pool: JobPool, sourceId: string, userId: string,
+  authorize: (job: JobRow, sql: JobSQL) => Promise<unknown>, create = false,
+): Promise<JobRow | null> {
+  return jobTransaction(pool, async sql => {
+    const source: JobRow | undefined = (await sql.query(
+      `SELECT * FROM ai_jobs WHERE id=$1${create ? " FOR UPDATE" : ""}`, [sourceId],
+    )).rows[0];
+    if (!source) throw new JobError("job_not_found", 404);
+    if (source.owner_user_id !== userId) throw new JobError("forbidden", 403);
+    if (source.service !== "email.summary" || source.entity_type !== "email")
+      throw new JobError("regeneration_email_only");
+    if (source.status !== "completed" || typeof source.result?.summary !== "string" ||
+        !source.result.summary.trim()) throw new JobError("regeneration_requires_completed");
+    await authorize(source, sql);
+    // No nonce from the browser: even two tabs or a lost POST response share this identity.
+    // Another deliberate generation can target the completed child, never mutate its parent.
+    const key = fingerprint(["email.summary.regeneration", source.id, userId]);
+    const existing = (await sql.query(
+      "SELECT * FROM ai_jobs WHERE idempotency_key=$1", [key],
+    )).rows[0];
+    if (existing || !create) return existing ?? null;
+    const inserted = await sql.query(`INSERT INTO ai_jobs
+      (id,service,entity_type,entity_id,owner_user_id,payload,idempotency_key,input_fingerprint,history)
+      VALUES ($1,'email.summary','email',$2,$3::varchar,$4::jsonb,$5,$6,
+        jsonb_build_array(jsonb_build_object('event','manual_regeneration','at',now(),
+          'sourceJobId',$7::text,'actor',$3::varchar)))
+      ON CONFLICT(idempotency_key) DO NOTHING RETURNING *`,
+    [randomUUID(), source.entity_id, userId, JSON.stringify(source.payload), key,
+      source.input_fingerprint, source.id]);
+    const child = inserted.rows[0] ?? (await sql.query(
+      "SELECT * FROM ai_jobs WHERE idempotency_key=$1", [key],
+    )).rows[0];
+    if (!child) throw new JobError("jobs_unavailable", 503);
+    return child;
+  });
+}
